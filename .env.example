# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Pooled connection - use for application runtime (port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection - use for Prisma migrations only (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase - backend only
# -----------------------------------------------------------------------------
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Next.js public env - safe to expose
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# NestJS API
# -----------------------------------------------------------------------------
API_PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production"

# -----------------------------------------------------------------------------
# Redis (Upstash) - v0.2+
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2) - v0.3+
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# -----------------------------------------------------------------------------
# Notifications - v0.2+
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
# "sandbox" (default) or "production" — selects api.sandbox.africastalking.com vs api.africastalking.com
AFRICASTALKING_MODE="sandbox"
# Optional soft alert threshold (KES) for the admin cost-summary banner
SMS_MONTHLY_COST_ALERT_KES="5000"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# Payments (Paystack) - v0.2+
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# -----------------------------------------------------------------------------
# PostHog (product analytics) - web frontend
# -----------------------------------------------------------------------------
# Public key for the browser SDK (posthog-js). Safe to expose to the client.
NEXT_PUBLIC_POSTHOG_KEY=""
# Ingestion host. Use https://eu.i.posthog.com for EU projects,
# https://us.i.posthog.com for US projects.
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Server-side project API key (posthog-node) - keep secret, server only.
# NOTE: not currently read by any code (lib/posthog-server.ts uses
# NEXT_PUBLIC_POSTHOG_KEY instead) - see docs/audits/posthog-capture-audit.md.
POSTHOG_API_KEY=""
# Salt for hashing user identities before they reach PostHog - keep secret,
# server only, deliberately not NEXT_PUBLIC_-prefixed. See
# apps/web/README-POSTHOG.md for how to generate one.
POSTHOG_HASH_SALT=""
